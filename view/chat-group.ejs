<%- include('layouts/header.ejs') %>
 <h2 class="mb-4"> Group</h2>
 
 <div class = "row">
    
    <div class="col-md-4">
        <ul class = "list-group">
            <% 
                if(myGroup.length > 0){
                    for(let i = 0; i < users.length; i++){
                        %>
                         <li class="list-group-item list-group-item-dark cursor-pointer group-list" data-id="<%= myGroup[i]['_id'] %>">
                            <img src="<%= myGroup[i]['image']%>" alt="" width="50px" height="50px">
                            <%= myGroup[i]['name'] %>
                         
                            
                        </li>

                        <%
                    
                    }
                }
            
            %>

             <%# Show joined groups %>
           
            <% 
                if(joinedGroup.length > 0){
                    for(let i = 0; i < joinedGroup.length; i++){
                        %>
                         <li class="list-group-item list-group-item-dark cursor-pointer group-list" data-id="<%= joinedGroup[i]['_id'] %>">
                            <img src="<%= joinedGroup[i]['image']%>" alt="" width="50px" height="50px">
                            <%= joinedGroup[i]['group_id']['name'] %>
                         
                            
                        </li>

                        <%
                    
                    }
                }
            
            %>

        </ul>
    </div>

    <div class="col-md-9">

        <h3 class="group-start-head">Click here to start the chat</h3>

        <div class="chat-section">

            <div class="group-chat-container">


            </div>

            <form action="" id="group-chat-form">
                <input type="text" name="message" placeholder="Enter Message" id="group-message" class="border" required>
                <input type="submit" value="Send Message" class="btn-btn-primary">
            </form>
        </div>

    </div>

 </div>

<div class="modal fade" id="updateGroupChatModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Update Message</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="update-group-chat-form">

      <div class="modal-body">
         <input type="text" name="id" id="update-group-message-id">
         <input type="text" name="message" id="update-group-message" class="form-control" placeholder="Enter updated message" required>
        
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Send message</button>
      </div>
      </form>
    </div>
  </div>
</div>


 <%- include('layouts/footer.ejs') %>
